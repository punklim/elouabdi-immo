# Copier ce fichier en ".env" sur le serveur et remplir les valeurs.
# Générer la clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=remplacer-par-une-longue-cle-secrete
DJANGO_ALLOWED_HOSTS=monsite.ma,www.monsite.ma
DJANGO_CSRF_TRUSTED_ORIGINS=https://monsite.ma,https://www.monsite.ma
SITE_URL=https://monsite.ma

# E-mails (serveur SMTP fourni par votre hébergeur ou un service d'envoi)
EMAIL_HOST=smtp.exemple.com
EMAIL_PORT=587
EMAIL_HOST_USER=contact@monsite.ma
EMAIL_HOST_PASSWORD=mot-de-passe-smtp
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=contact@monsite.ma
